# Configuración del Servidor Express
PORT=3000
NODE_ENV=development

# Base de Datos MongoDB (Driver Nativo)
MONGODB_URI=mongodb://localhost:27017
DB_NAME=rutaia_db

# Seguridad JWT
JWT_SECRET=tu_secreto_super_seguro_jwt

# URLs de Webhooks n8n (Patrón Proxy)
N8N_CHAT_WEBHOOK_URL=http://localhost:5678/webhook/chat-student
N8N_DOCS_WEBHOOK_URL=http://localhost:5678/webhook/upload-docs